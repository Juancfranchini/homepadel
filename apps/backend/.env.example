# ─────────────────────────────────────────────────────────────────────────────
# Backend — variables de entorno
#
# Copiar como .env y completar. Las marcadas OBLIGATORIA impiden que la
# aplicación arranque o dejan una funcionalidad rota si faltan.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# OBLIGATORIA. Cadena de conexión a PostgreSQL.
# En Railway se genera sola al agregar el servicio de Postgres.
DATABASE_URL="postgresql://usuario:password@localhost:5432/homepadel"

# ── Autenticación ────────────────────────────────────────────────────────────
# OBLIGATORIA. Clave con la que se firman los tokens de sesión.
# Usar una cadena larga y aleatoria; cambiarla invalida todas las sesiones activas.
JWT_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# Solo para ejecutar prisma:seed o prisma/reset-admin.ts. Nunca usar una clave
# conocida ni commitear el valor real.
SEED_ADMIN_EMAIL="admin@homepadel.com"
SEED_ADMIN_PASSWORD=""

# ── Inicio de sesión con Google ──────────────────────────────────────────────
# Credenciales OAuth 2.0 tipo "Aplicación web" de Google Cloud Console.
# El redirect URI debe coincidir exactamente con el autorizado en Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
# "production" activa las validaciones estrictas de pagos (ver más abajo).
NODE_ENV=development

# ── URLs públicas ────────────────────────────────────────────────────────────
# OBLIGATORIAS EN PRODUCCIÓN. Sin ellas el checkout de Mercado Pago falla de
# forma visible en lugar de perder la venta en silencio.
#
# FRONTEND_URL: a dónde vuelve el comprador después de pagar.
# BACKEND_URL:  dónde Mercado Pago avisa que el pago se aprobó. Si apunta a un
#               lugar inexistente, el cobro entra y la orden no se registra.
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
BACKOFFICE_URL="http://localhost:3001"

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Credenciales del panel de desarrolladores de Mercado Pago.
# Usar las de prueba mientras se desarrolla; las de producción cobran de verdad.
MERCADOPAGO_ACCESS_TOKEN=""

# OBLIGATORIA EN PRODUCCIÓN. Clave secreta del webhook, del mismo panel.
# Sin ella los avisos de pago se rechazan por diseño: aceptarlos sin verificar
# permitiría a cualquiera marcar órdenes como pagadas.
MERCADOPAGO_WEBHOOK_SECRET=""

# Transferencia queda deshabilitada aunque la configuración histórica siga
# guardada. Para reactivarla se requieren este flag y `active: true` en el CMS.
ENABLE_BANK_TRANSFER="false"

# ── Almacenamiento de imágenes ───────────────────────────────────────────────
# Cadena de conexión de Cloudinary, del panel de la cuenta.
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Sin esto las imágenes se guardan en el disco del contenedor y se pierden
# en cada despliegue.
CLOUDINARY_URL=""

MAX_FILE_SIZE=5242880
UPLOADS_DIR="./uploads"

# ── Meta / Facebook (opcional) ───────────────────────────────────────────────
# Solo si se usa la API de conversiones para medir compras.
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# Messenger queda oculto del sitio público sin borrar su registro. Cambiar a
# "true" permite reactivarlo; WhatsApp y email no dependen de esta variable.
MESSENGER_CHANNEL_ENABLED="false"

# Secreto compartido con la tienda para refrescar la portada al guardar una
# seccion. Tiene que ser el mismo valor que REVALIDATE_SECRET en el frontend.
# Sin el, un cambio del backoffice se ve recien cuando vence el cache.
REVALIDATE_SECRET=
