# ─────────────────────────────────────────────────────────────────────────────
# Backoffice (panel de administración) — variables de entorno
#
# Copiar como .env.local y completar.
# Todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador:
# nunca poner acá una credencial.
# ─────────────────────────────────────────────────────────────────────────────

# OBLIGATORIA. Dirección del backend, incluyendo el prefijo /api.
# El panel envía el token de sesión en cada petición; las credenciales de las
# integraciones (Cloudinary, Mercado Pago) se administran desde la interfaz y
# viven en la base, no acá.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
