# ─────────────────────────────────────────────────────────────────────────────
# Frontend (tienda pública) — variables de entorno
#
# Copiar como .env.local y completar.
# Todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador:
# nunca poner acá una credencial.
# ─────────────────────────────────────────────────────────────────────────────

# OBLIGATORIA. Dirección del backend, incluyendo el prefijo /api.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Dirección pública de este sitio. Se usa para armar las URLs absolutas de los
# metadatos (Open Graph, enlace canónico) que ven las redes sociales al compartir.
#
# Si no se define, en Vercel se usa el dominio del despliegue y en local
# http://localhost:3000. Conviene fijarla en producción para que las
# previsualizaciones al compartir apunten al lugar correcto.
NEXT_PUBLIC_SITE_URL=""
